{
  "rules": {
    ".read": false,
    ".write": false,
    "publicStore": {
      ".read": true,
      "products": {
        ".indexOn": [
          "category",
          "visible"
        ]
      }
    },
    "customers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "privateReferences": {
      ".read": false
    },
    "privateSettings": {
      ".read": false
    }
  }
}
